# Large binary CAD assets must be uploaded using Git LFS before the initial asset commit.
*.stl filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text
*.3mf filter=lfs diff=lfs merge=lfs -text
*.3MF filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.ZIP filter=lfs diff=lfs merge=lfs -text

# sha256sum -c needs LF-only paths even on Windows checkouts.
releases/v5/Vi_Gauntlet_X1C_V5_Draft/V5_SHA256_MANIFEST.txt text eol=lf
releases/v5/Vi_Gauntlet_X1C_V5_Draft/V5_1_SHA256_MANIFEST.txt text eol=lf
